# -----------------------------------------------------------------------------
# Environment configuration TEMPLATE.
#
# Copy to `.env` and fill in real values. `.env` is gitignored and NEVER
# committed. Every secret below belongs to the CLIENT's accounts, supplied at
# deploy time. No default here is a real credential.
# -----------------------------------------------------------------------------

# --- Postgres -----------------------------------------------------------------
POSTGRES_USER=cs2
POSTGRES_PASSWORD=change-me-in-real-env
POSTGRES_DB=cs2demo
# Full URL the backend/worker use. Host is the compose service name `db`.
DATABASE_URL=postgresql+psycopg://cs2:change-me-in-real-env@db:5432/cs2demo

# --- Redis --------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Uploads / disk -----------------------------------------------------------
# Where chunked uploads land before parsing. Files are DELETED after parse.
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_BYTES=524288000          # 500 MB hard ceiling (demos are 200-400 MB)

# --- Anthropic (client's key) -------------------------------------------------
ANTHROPIC_API_KEY=                  # client-supplied, required for Phase 4
ANALYSIS_MODEL_ID=claude-haiku-4-5-20251001
ANALYSIS_MAX_OUTPUT_TOKENS=4000     # hard cap so a runaway job cannot burn balance
# Prices used to compute cost_usd per job. Update when Anthropic pricing changes.
# USD per 1M tokens.
PRICE_INPUT_PER_MTOK=0.80
PRICE_OUTPUT_PER_MTOK=4.00
PRICE_CACHED_INPUT_PER_MTOK=0.08

# --- Payments (merchant-of-record; client picks provider) ---------------------
# Provider is selected behind a thin interface. Only one set is used at a time.
PAYMENT_PROVIDER=lemonsqueezy        # lemonsqueezy | paddle
PAYMENT_WEBHOOK_SECRET=              # signing secret for webhook verification
PAYMENT_API_KEY=                     # provider API key (if needed for lookups)

# --- App ----------------------------------------------------------------------
APP_SECRET_KEY=                      # session/JWT signing; generate a random 32+ byte value
APP_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:5173
ENVIRONMENT=development              # development | production
