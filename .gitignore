# Secrets — never commit real values. Only .env.example is tracked.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Node / frontend
node_modules/
frontend/dist/
*.local

# Bundled demo sample for the viewer is derived data (3-4 MB) — not committed.
# The app's drop-zone loads any out.json; `make sample` re-creates this locally.
frontend/public/demo/

# Runtime data — uploads are transient, derived data lives in Postgres.
# Nothing here should ever be committed.
data/uploads/
data/tmp/
*.dem
out.json
out*.json

# Editor / OS
.DS_Store
.idea/
.vscode/
frontend/*.tsbuildinfo

# stray vite cache if a dev server is run from backend/
.vite/
