# Frontend build-time config. Copy to `.env` (or `.env.local`) for local dev.
# Vite only exposes vars prefixed with VITE_ to the browser bundle.

# Base URL of the analysis test server (backend/app/main.py). Defaults to the
# local dev server when unset. There is NO secret here — the API key lives only
# on the backend; the browser only ever talks to this URL.
VITE_API_URL=http://localhost:8000
